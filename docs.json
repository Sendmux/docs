            "group": "Attachments",
            "pages": [
              "POST /emails/attachments",
              "GET /emails/attachments/{attachment_id}",
              "POST /emails/attachment-uploads",
              "PUT /emails/attachment-uploads/{upload_id}"
            ]
          }
        ]
      }
